        <td>681 (<strong>11.8%</strong>)</td>
        <td>27 (<strong>10.5%</strong>)</td>
        <td>Sec. 17(5) blocked credits, supplier GSTR-2B filing default penalties</td>
      </tr>
      <tr>
        <td><strong>Valuation (Sec. 15)</strong></td>
        <td>354 (<strong>6.1%</strong>)</td>
        <td>11 (<strong>4.3%</strong>)</td>
        <td>Related party transactions, post-sale volume discounts, TDS liabilities</td>
      </tr>
      <tr>
        <td><strong>Composite vs. Mixed (Sec. 8)</strong></td>
        <td>319 (<strong>5.5%</strong>)</td>
        <td>4 (<strong>1.6%</strong>)</td>
        <td>Subjective test of "naturally bundled in ordinary course of business"</td>
      </tr>
      <tr>
        <td><strong>Procedure & Jurisdiction</strong></td>
        <td>36 (<strong>0.6%</strong>)</td>
        <td>14 (<strong>5.4%</strong>)</td>
        <td>Sec. 98 maintainability when scrutiny or departmental inquiry is pending</td>
      </tr>
    </tbody>
  </table>

